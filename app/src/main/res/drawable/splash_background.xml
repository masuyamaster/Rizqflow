<?xml version="1.0" encoding="utf-8"?>
<!-- Latar jendela saat start: wordmark penuh di atas warna splash. Dipakai Android 11 ke bawah dan ROM yang menggambar pratinjau dari windowBackground.
     Lebar 350dp harus sama dengan batas lebar wordmark di layar loading (AppRoot) supaya peralihannya tidak melompat. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/ic_launcher_background" />
    </item>
    <item
        android:width="350dp"
        android:height="71.4dp"
        android:drawable="@drawable/ic_rizqflow_wordmark"
        android:gravity="center" />
</layer-list>
