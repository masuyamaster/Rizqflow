<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema jendela saja (latar saat aplikasi dibuka); tampilan sebenarnya memakai Compose (ui/theme). -->
    <style name="Theme.Rizqflow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/rf_background</item>
    </style>

    <!-- Splash: latar sama dengan warna latar launcher icon (ic_launcher_background) supaya menyatu; setelah siap beralih ke Theme.Rizqflow. -->
    <style name="Theme.Rizqflow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Rizqflow</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
