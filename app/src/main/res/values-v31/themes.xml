<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: ikon splash sistem dipotong topeng lingkaran sehingga wordmark selebar layar tak bisa dipasang di sana.
         Splash sistem dimatikan supaya yang pertama tampil adalah jendela aplikasi, yang langsung menggambar wordmark penuh (AppRoot). -->
    <style name="Theme.Rizqflow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Rizqflow</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
